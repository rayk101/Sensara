# Add fresh credentials locally, or in Railway service Variables when hosted.
# All integrations are disabled until their values are supplied.

# MongoDB connection string (optional; Railway MongoDB or Atlas)
# If not set, the app runs in demo mode with in-memory mock data
MONGODB_URI=
MONGODB_DB=

# Anthropic API key for the AI Care Assistant (optional)
# If not set, the assistant returns realistic mock guidance
ANTHROPIC_API_KEY=

# AWS S3 — critical event video clip storage (optional)
# If not set, the app saves events without video clips (S3 Not Configured shown in UI)
# Create an IAM user with PutObject + GetObject permissions for the bucket below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ElevenLabs Speech-to-Text — audio distress detection (optional)
# If not set, STT is disabled but audio monitor simulation still works
ELEVENLABS_API_KEY=

# Photon iMessage alerts (optional; enroll the recipient in your Photon project)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Shared recipient for Photon and optional Twilio, in E.164 format (e.g. +15551234567)
CAREGIVER_PHONE_NUMBER=

# Optional Twilio SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Resend email alerts
RESEND_API_KEY=
CAREGIVER_EMAIL=
ALERT_FROM_EMAIL=
