# Add fresh credentials locally, or in Railway service Variables when hosted.
# Provider actions also require persisted application settings and recipient assignments.

# MongoDB replica set/Atlas connection; required for persistent application use
MONGODB_URI=
MONGODB_DB=
# Optional Node-process DNS override when the local network fails Atlas SRV lookups.
# Example: 1.1.1.1,8.8.8.8. Leave empty when system DNS works; restart after changing.
MONGODB_DNS_SERVERS=

# Anthropic API key for the AI Care Assistant (optional)
# If not set, the assistant returns realistic mock guidance
ANTHROPIC_API_KEY=

# AWS S3 — critical event video clip storage (optional)
# If not set, the app saves events without video clips (S3 Not Configured shown in UI)
# Create an IAM user with PutObject + GetObject permissions for the bucket below.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ElevenLabs Speech-to-Text — audio distress detection (optional)
# If not set, STT is disabled but audio monitor simulation still works
ELEVENLABS_API_KEY=

# Photon iMessage alerts (optional; enroll the recipient in your Photon project)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Shared recipient for Photon and optional Twilio, in E.164 format (e.g. +15551234567)
CAREGIVER_PHONE_NUMBER=

# Optional Twilio SMS alerts
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Resend email alerts
RESEND_API_KEY=
CAREGIVER_EMAIL=
ALERT_FROM_EMAIL=

# Local-only fictional demo access. Never enable this on a public deployment.
LOCAL_DEMO_MODE=false
# Production staff accounts: [{"id":"staff-id","name":"Name","role":"caregiver","patientIds":["resident_001"],"passwordHash":"salt:scrypt-hex","active":true}]
STAFF_ACCOUNTS_JSON=[]
AUTH_SESSION_SECRET=
APP_ORIGIN=
# Starts the MongoDB outbox processor in the persistent Node server.
NOTIFICATION_WORKER_ENABLED=true
# Optional preferred bucket alias; AWS_S3_BUCKET remains supported.
S3_VIDEO_BUCKET=
# SDK default credential chain supports AWS_PROFILE, AWS_SESSION_TOKEN and roles.
AWS_SESSION_TOKEN=
# ElevenLabs TTS is separate from STT permission.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
